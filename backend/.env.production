# ============================================================
# BACKEND PRODUCTION ENVIRONMENT
# ============================================================
# Copy this to backend/.env in production
# ============================================================

# Database (PostgreSQL)
# Get this from your database provider (Supabase, Neon, Render, etc.)
DATABASE_URL="postgresql://user:password@host:port/database?sslmode=require"

# JWT Configuration
# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET="your-super-secret-jwt-key-min-64-chars-generate-with-crypto"
JWT_EXPIRES_IN="24h"

# Bcrypt Configuration
BCRYPT_SALT_ROUNDS=10

# Server Configuration
PORT=5000
NODE_ENV="production"

# CORS - Add your frontend domain(s)
CORS_ORIGINS="https://your-frontend-url.vercel.app,https://www.yourdomain.com"

# Super Admin (Change immediately after first login!)
SUPER_ADMIN_EMAIL="admin@platform.com"
SUPER_ADMIN_PASSWORD="ChangeThisPassword123!"

# Admin Security (Optional but recommended)
ADMIN_ALLOWED_IPS=""
ADMIN_REQUIRE_2FA=false
ADMIN_LOCKOUT_DURATION=15
ADMIN_MAX_LOGIN_ATTEMPTS=5

# QR Code Security
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
QR_SECRET="your-qr-secret-key-min-32-chars"
QR_TOKEN_EXPIRY_HOURS=4
