// ============================================================
// PRODUCTION-READY PRISMA SCHEMA
// Multi-Tenant Hotel Management System
// ============================================================
// 
// SECURITY FEATURES:
// - Role-based access control (RBAC)
// - Multi-tenant data isolation via hotelId
// - Cascading deletes for data integrity
// - Proper indexing for performance
// - Soft deletes for audit trail
// ============================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================================
// ENUMS
// ============================================================

enum Role {
  SUPER_ADMIN  // Platform administrator - no hotelId
  OWNER        // Hotel owner - manages one hotel
  KITCHEN      // Kitchen staff - belongs to one hotel
  WAITER       // Waiter/Cashier - belongs to one hotel
}

enum SubscriptionPlan {
  TRIAL        // 14-day trial
  STARTER      // Basic plan - ₹499/month
  PRO          // Professional - ₹999/month
  BUSINESS     // Enterprise - ₹1999/month
}

enum OrderStatus {
  PENDING      // Order placed, waiting for kitchen
  PREPARING    // Kitchen is preparing
  READY        // Ready for service
  SERVED       // Delivered to customer
  CANCELLED    // Order cancelled
}

enum PaymentStatus {
  UNPAID       // Payment pending
  PAID         // Payment completed
  REFUNDED     // Payment refunded
}

enum PaymentMethod {
  CASH         // Cash payment
  UPI          // UPI payment
  CARD         // Credit/Debit card
}

enum TableStatus {
  AVAILABLE    // Table is free
  OCCUPIED     // Table is in use
  RESERVED     // Table is reserved
}

// ============================================================
// USER MODEL
// ============================================================
// Stores all user accounts (Super Admin, Owners, Staff)
// SECURITY: Password is hashed with bcrypt before storage
// SECURITY: hotelId is NULL for SUPER_ADMIN (platform-level)
// SECURITY: hotelId is REQUIRED for all other roles

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  password      String    // bcrypt hashed - NEVER store plain text
  name          String
  role          Role
  hotelId       String?   // NULL for SUPER_ADMIN, required for others
  hotel         Hotel?    @relation(fields: [hotelId], references: [id], onDelete: Cascade)
  isActive      Boolean   @default(true)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  lastLoginAt   DateTime?
  
  // Relations
  createdOrders Order[]   @relation("OrderCreator")
  handledOrders Order[]   @relation("OrderHandler")
  
  // Indexes for performance
  @@index([email])
  @@index([hotelId])
  @@index([role])
  @@index([isActive])
  @@index([hotelId, role])
}

// ============================================================
// HOTEL MODEL (TENANT)
// ============================================================
// Each hotel is a separate tenant in the multi-tenant system
// SECURITY: All hotel-scoped data must validate hotelId

model Hotel {
  id                    String            @id @default(cuid())
  name                  String
  address               String?
  phone                 String?
  email                 String?
  logo                  String?
  subscriptionPlan      SubscriptionPlan  @default(TRIAL)
  subscriptionStart     DateTime          @default(now())
  subscriptionEnd       DateTime
  isActive              Boolean           @default(true)
  maxTables             Int               @default(10)
  maxMenuItems          Int               @default(50)
  maxStaff              Int               @default(5)
  createdAt             DateTime          @default(now())
  updatedAt             DateTime          @updatedAt
  
  // Relations
  users                 User[]
  tables                Table[]
  menuItems             MenuItem[]
  orders                Order[]
  
  // Indexes
  @@index([isActive])
  @@index([subscriptionEnd])
  @@index([subscriptionPlan])
}

// ============================================================
// TABLE MODEL
// ============================================================
// Restaurant tables for customer seating
// SECURITY: hotelId ensures data isolation

model Table {
  id            String      @id @default(cuid())
  hotelId       String      // CRITICAL: Multi-tenant isolation
  hotel         Hotel       @relation(fields: [hotelId], references: [id], onDelete: Cascade)
  tableNumber   Int
  capacity      Int         @default(4)
  qrToken       String      @unique
  status        TableStatus @default(AVAILABLE)
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  
  // Relations
  orders        Order[]
  
  // Constraints
  @@unique([hotelId, tableNumber])
  @@index([hotelId])
  @@index([hotelId, status])
}

// ============================================================
// MENU ITEM MODEL
// ============================================================
// Food/drink items available for ordering
// SECURITY: hotelId ensures data isolation

model MenuItem {
  id              String    @id @default(cuid())
  hotelId         String    // CRITICAL: Multi-tenant isolation
  hotel           Hotel     @relation(fields: [hotelId], references: [id], onDelete: Cascade)
  name            String
  description     String?
  price           Decimal   @db.Decimal(10, 2)
  category        String
  imageUrl        String?
  isAvailable     Boolean   @default(true)
  prepTimeMinutes Int       @default(15)
  sortOrder       Int       @default(0)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  
  // Indexes
  @@index([hotelId])
  @@index([hotelId, category])
  @@index([hotelId, isAvailable])
}

// ============================================================
// ORDER MODEL
// ============================================================
// Customer orders with items, status, and payment info
// SECURITY: hotelId ensures data isolation
// SECURITY: createdBy and handledBy track user actions

model Order {
  id              String          @id @default(cuid())
  hotelId         String          // CRITICAL: Multi-tenant isolation
  hotel           Hotel           @relation(fields: [hotelId], references: [id], onDelete: Cascade)
  tableId         String
  table           Table           @relation(fields: [tableId], references: [id], onDelete: Restrict)
  
  items           Json            
  
  totalAmount     Decimal         @db.Decimal(10, 2)
  status          OrderStatus     @default(PENDING)
  paymentStatus   PaymentStatus   @default(UNPAID)
  paymentMethod   PaymentMethod?
  
  createdBy       String
  creator         User            @relation("OrderCreator", fields: [createdBy], references: [id])
  handledBy       String?
  handler         User?           @relation("OrderHandler", fields: [handledBy], references: [id])
  
  notes           String?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
  
  // Indexes
  @@index([hotelId])
  @@index([hotelId, status])
  @@index([hotelId, paymentStatus])
  @@index([hotelId, createdAt])
  @@index([tableId])
  @@index([createdBy])
  @@index([handledBy])
}

// ============================================================
// AUDIT LOG MODEL
// ============================================================
// Track all critical actions for security auditing

model AuditLog {
  id            String    @id @default(cuid())
  userId        String?
  action        String
  resource      String
  resourceId    String?
  hotelId       String?
  metadata      Json?
  createdAt     DateTime  @default(now())
  
  @@index([userId])
  @@index([hotelId])
  @@index([action])
  @@index([createdAt])
}
