# ============================================================
# DATABASE CONFIGURATION
# ============================================================
# PostgreSQL connection string
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=SCHEMA
# 
# LOCAL DEVELOPMENT:
DATABASE_URL="postgresql://postgres:password@localhost:5432/restroflow_dev?schema=public"
#
# PRODUCTION (example):
# DATABASE_URL="postgresql://user:password@host:port/database?schema=public"

# ============================================================
# JWT CONFIGURATION
# ============================================================
# Secret key for signing JWT tokens
# GENERATE WITH: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
# 
# SECURITY: Use a strong, random secret (at least 64 characters)
# SECURITY: Never commit this to version control
# SECURITY: Rotate this secret periodically (will invalidate all tokens)
JWT_SECRET="your-super-secret-jwt-key-change-this-in-production-min-64-chars-long-abc123xyz789"

# JWT expiration time
# Format: "15m" (15 minutes), "1h" (1 hour), "7d" (7 days)
# RECOMMENDATION: Use short expiry (15m-1h) + refresh tokens for production
JWT_EXPIRES_IN="24h"

# ============================================================
# BCRYPT CONFIGURATION
# ============================================================
# Number of salt rounds for password hashing
# Higher = more secure but slower
# RECOMMENDATION: 10-12 for production (10 is default)
BCRYPT_SALT_ROUNDS=10

# ============================================================
# SERVER CONFIGURATION
# ============================================================
PORT=5000
NODE_ENV=development

# CORS origins (comma-separated)
# SECURITY: Only allow your frontend domain(s)
CORS_ORIGINS="http://localhost:5173,http://localhost:3000,https://yourdomain.com"

# ============================================================
# SUPER ADMIN CONFIGURATION
# ============================================================
# Initial super admin credentials (used in seed script only)
# SECURITY: Change these immediately after first login
# SECURITY: Delete this from .env after seeding
SUPER_ADMIN_EMAIL="admin@platform.com"
SUPER_ADMIN_PASSWORD="ChangeThisPassword123!"

# ============================================================
# ADMIN SECURITY (Optional)
# ============================================================
# IP whitelist for admin routes (comma-separated, leave empty to disable)
ADMIN_ALLOWED_IPS=""

# Require 2FA for admin access
ADMIN_REQUIRE_2FA=false

# Lockout duration (in minutes)
ADMIN_LOCKOUT_DURATION=15

# Max login attempts before lockout
ADMIN_MAX_LOGIN_ATTEMPTS=5
