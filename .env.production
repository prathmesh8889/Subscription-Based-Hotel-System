# ============================================================
# PRODUCTION ENVIRONMENT CONFIGURATION
# ============================================================
# Frontend (Vercel)
# ============================================================

# API URL - Point to your backend deployment
VITE_API_URL="https://your-backend-url.vercel.app/api"

# Socket URL - Point to your backend WebSocket
VITE_SOCKET_URL="https://your-backend-url.vercel.app"

# Environment
VITE_APP_ENV="production"

# ============================================================
# BACKEND ENVIRONMENT (Render/Railway/Heroku)
# ============================================================
# Copy this to backend/.env in production

# Database (PostgreSQL)
DATABASE_URL="postgresql://user:password@host:port/database?sslmode=require"

# JWT Configuration
JWT_SECRET="your-super-secret-jwt-key-min-64-chars-generate-with-crypto"
JWT_EXPIRES_IN="24h"

# Bcrypt Configuration
BCRYPT_SALT_ROUNDS=10

# Server Configuration
PORT=5000
NODE_ENV="production"

# CORS - Add your frontend domain
CORS_ORIGINS="https://your-frontend-url.vercel.app"

# Super Admin (Change immediately after first login!)
SUPER_ADMIN_EMAIL="admin@platform.com"
SUPER_ADMIN_PASSWORD="ChangeThisPassword123!"

# Admin Security (Optional but recommended)
ADMIN_ALLOWED_IPS=""
ADMIN_REQUIRE_2FA=false
ADMIN_LOCKOUT_DURATION=15
ADMIN_MAX_LOGIN_ATTEMPTS=5

# QR Code Security
QR_SECRET="your-qr-secret-key-min-32-chars"
QR_TOKEN_EXPIRY_HOURS=4
