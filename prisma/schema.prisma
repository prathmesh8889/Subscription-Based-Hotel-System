// ============================================================
// PRODUCTION-READY PRISMA SCHEMA
// Multi-Tenant Hotel Management System
// ============================================================
// 
// SECURITY FEATURES:
// - Role-based access control (RBAC)
// - Multi-tenant data isolation via hotelId
// - Cascading deletes for data integrity
// - Proper indexing for performance
// - Soft deletes for audit trail
// ============================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================================
// ENUMS
// ============================================================

enum Role {
  SUPER_ADMIN  // Platform administrator - no hotelId
  OWNER        // Hotel owner - manages one hotel
  KITCHEN      // Kitchen staff - belongs to one hotel
  WAITER       // Waiter/Cashier - belongs to one hotel
}

enum SubscriptionPlan {
  TRIAL        // 14-day trial
  STARTER      // Basic plan - ₹499/month
  PRO          // Professional - ₹999/month
  BUSINESS     // Enterprise - ₹1999/month
}

enum OrderStatus {
  PENDING      // Order placed, waiting for kitchen
  PREPARING    // Kitchen is preparing
  READY        // Ready for service
  SERVED       // Delivered to customer
  CANCELLED    // Order cancelled
}

enum PaymentStatus {
  UNPAID       // Payment pending
  PAID         // Payment completed
  REFUNDED     // Payment refunded
}

enum PaymentMethod {
  CASH         // Cash payment
  UPI          // UPI payment
  CARD         // Credit/Debit card
}

enum TableStatus {
  AVAILABLE    // Table is free
  OCCUPIED     // Table is in use
  RESERVED     // Table is reserved
}

// ============================================================
// USER MODEL
// ============================================================
// Stores all user accounts (Super Admin, Owners, Staff)
// SECURITY: Password is hashed with bcrypt before storage
// SECURITY: hotelId is NULL for SUPER_ADMIN (platform-level)
// SECURITY: hotelId is REQUIRED for all other roles

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  password      String    // bcrypt hashed - NEVER store plain text
  name          String
  role          Role
  hotelId       String?   // NULL for SUPER_ADMIN, required for others
  hotel         Hotel?    @relation(fields: [hotelId], references: [id], onDelete: Cascade)
  isActive      Boolean   @default(true)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  lastLoginAt   DateTime?
  
  // Relations
  createdOrders Order[]   @relation("OrderCreator")  // Orders created by this user
  handledOrders Order[]   @relation("OrderHandler")  // Orders handled by kitchen/waiter
  
  // Indexes for performance
  @@index([email])
  @@index([hotelId])
  @@index([role])
  @@index([isActive])
  @@index([hotelId, role])  // Composite index for hotel-scoped role queries
}

// ============================================================
// HOTEL MODEL (TENANT)
// ============================================================
// Each hotel is a separate tenant in the multi-tenant system
// SECURITY: All hotel-scoped data must validate hotelId

model Hotel {
  id                    String            @id @default(cuid())
  name                  String
  address               String?
  phone                 String?
  email                 String?           // Hotel contact email
  logo                  String?           // URL to logo image
  subscriptionPlan      SubscriptionPlan  @default(TRIAL)
  subscriptionStart     DateTime          @default(now())
  subscriptionEnd       DateTime          // When subscription expires
  isActive              Boolean           @default(true)
  maxTables             Int               @default(10)    // Plan limit
  maxMenuItems          Int               @default(50)    // Plan limit
  maxStaff              Int               @default(5)     // Plan limit
  createdAt             DateTime          @default(now())
  updatedAt             DateTime          @updatedAt
  
  // Relations
  users                 User[]            // All users belonging to this hotel
  tables                Table[]           // Restaurant tables
  menuItems             MenuItem[]        // Menu items
  orders                Order[]           // All orders
  
  // Indexes
  @@index([isActive])
  @@index([subscriptionEnd])
  @@index([subscriptionPlan])
}

// ============================================================
// TABLE MODEL
// ============================================================
// Restaurant tables for customer seating
// SECURITY: hotelId ensures data isolation

model Table {
  id            String      @id @default(cuid())
  hotelId       String      // CRITICAL: Multi-tenant isolation
  hotel         Hotel       @relation(fields: [hotelId], references: [id], onDelete: Cascade)
  tableNumber   Int
  capacity      Int         @default(4)
  qrToken       String      @unique  // Secure token for QR code
  status        TableStatus @default(AVAILABLE)
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  
  // Relations
  orders        Order[]
  
  // Constraints
  @@unique([hotelId, tableNumber])  // No duplicate table numbers per hotel
  @@index([hotelId])
  @@index([hotelId, status])
}

// ============================================================
// MENU ITEM MODEL
// ============================================================
// Food/drink items available for ordering
// SECURITY: hotelId ensures data isolation

model MenuItem {
  id              String    @id @default(cuid())
  hotelId         String    // CRITICAL: Multi-tenant isolation
  hotel           Hotel     @relation(fields: [hotelId], references: [id], onDelete: Cascade)
  name            String
  description     String?
  price           Decimal   @db.Decimal(10, 2)
  category        String    // e.g., "Starters", "Main Course", "Beverages"
  imageUrl        String?
  isAvailable     Boolean   @default(true)
  prepTimeMinutes Int       @default(15)
  sortOrder       Int       @default(0)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  
  // Indexes
  @@index([hotelId])
  @@index([hotelId, category])
  @@index([hotelId, isAvailable])
}

// ============================================================
// ORDER MODEL
// ============================================================
// Customer orders with items, status, and payment info
// SECURITY: hotelId ensures data isolation
// SECURITY: createdBy and handledBy track user actions

model Order {
  id              String          @id @default(cuid())
  hotelId         String          // CRITICAL: Multi-tenant isolation
  hotel           Hotel           @relation(fields: [hotelId], references: [id], onDelete: Cascade)
  tableId         String
  table           Table           @relation(fields: [tableId], references: [id], onDelete: Restrict)
  
  // Order items stored as JSON for flexibility
  // Format: [{ menuItemId, name, price, quantity, notes }]
  items           Json            
  
  totalAmount     Decimal         @db.Decimal(10, 2)
  status          OrderStatus     @default(PENDING)
  paymentStatus   PaymentStatus   @default(UNPAID)
  paymentMethod   PaymentMethod?
  
  // Audit trail
  createdBy       String          // User ID who created the order
  creator         User            @relation("OrderCreator", fields: [createdBy], references: [id])
  handledBy       String?         // User ID (kitchen/waiter) who handled the order
  handler         User?           @relation("OrderHandler", fields: [handledBy], references: [id])
  
  notes           String?         // Special instructions
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
  
  // Indexes
  @@index([hotelId])
  @@index([hotelId, status])
  @@index([hotelId, paymentStatus])
  @@index([hotelId, createdAt])
  @@index([tableId])
  @@index([createdBy])
  @@index([handledBy])
}

// ============================================================
// SESSION MODEL (Optional - for advanced security)
// ============================================================
// Track active sessions for security auditing
// Can be used to invalidate sessions, track logins, etc.

model Session {
  id            String    @id @default(cuid())
  userId        String
  token         String    @unique  // JWT or session token
  ipAddress     String?
  userAgent     String?
  expiresAt     DateTime
  createdAt     DateTime  @default(now())
  
  @@index([userId])
  @@index([expiresAt])
}

// ============================================================
// AUDIT LOG MODEL (Optional - for compliance)
// ============================================================
// Track all critical actions for security auditing

model AuditLog {
  id            String    @id @default(cuid())
  userId        String?   // NULL for system actions
  action        String    // e.g., "USER_LOGIN", "ORDER_CREATED", "MENU_UPDATED"
  resource      String    // e.g., "User", "Order", "MenuItem"
  resourceId    String?   // ID of the affected resource
  hotelId       String?   // NULL for platform-level actions
  metadata      Json?     // Additional context (IP, changes, etc.)
  createdAt     DateTime  @default(now())
  
  @@index([userId])
  @@index([hotelId])
  @@index([action])
  @@index([createdAt])
}
